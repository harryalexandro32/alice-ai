# Salin ke .env lalu isi. .env tidak ikut git.
# Satu proses = satu bisnis = satu nomor WhatsApp = satu .env.

# --- Bisnis & jalur ----------------------------------------------------------
# Nama folder di src/business/.
BUSINESS=gfan
# baileys = perangkat tertaut (tidak resmi, untuk demo).
# cloud   = WhatsApp Cloud API resmi (lihat docs/cloud-api-setup.md).
TRANSPORT=baileys

# --- LLM (OpenAI-compatible; bawaan DeepSeek) --------------------------------
# Kosong = bot tetap jalan: salam, minta data, follow-up, tapi pertanyaan
# dijawab dengan "kami teruskan ke tim".
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# Batas panggilan per hari. Habis = balasan cadangan, bukan mati.
LLM_DAILY_LIMIT=1500
# Tarif untuk perkiraan biaya di dashboard, USD per 1 juta token, dan kurs.
# Bawaan = tarif jam sibuk DeepSeek (di luar jam sibuk separuhnya).
LLM_PRICE_IN=0.3
LLM_PRICE_CACHED=0.006
LLM_PRICE_OUT=1.2
USD_IDR=16500

# --- Waktu -------------------------------------------------------------------
BOT_TZ=Asia/Jakarta

# --- Follow-up ---------------------------------------------------------------
# Jam diam pelanggan sebelum diingatkan. 23 = masih di dalam jendela gratis
# 24 jam Cloud API. Follow-up hanya dikirim di antara dua jam di bawah.
FOLLOWUP_AFTER_HOURS=23
FOLLOWUP_START_HOUR=8
FOLLOWUP_END_HOUR=20
# Batas keras jam sejak pesan terakhir pelanggan. Kosong = otomatis: 24 di
# jalur cloud (yang jatuh malam dimajukan ke sore), tanpa batas di baileys.
FOLLOWUP_MAX_HOURS=
# Total follow-up seumur satu nomor.
FOLLOWUP_MAX_TOTAL=2

# --- Manusia mengambil alih ---------------------------------------------------
# Kalau pemilik membalas sendiri dari aplikasi, bot diam selama ini untuk kontak itu.
HUMAN_PAUSE_HOURS=12

# --- Tujuan lead -------------------------------------------------------------
# SATU nomor sales penerima ringkasan lead (628xxx).
# "self" = nomor bot itu sendiri (sales membalas dari aplikasi di nomor yang sama):
#   - baileys: ringkasan masuk ke chat "pesan ke diri sendiri".
#   - cloud  : tidak bisa mengirimi diri sendiri -> dilewat; lead ada di Sheet
#              dan percakapannya terlihat langsung di aplikasi.
# Kosong = tanpa notifikasi WA.
SALES_NUMBER=
# Google Sheet: ID dari URL, nama tab, dan file kunci akun layanan.
# Sheet-nya harus dibagikan (Editor) ke email akun layanan tersebut.
SHEET_ID=
SHEET_TAB=Leads
GOOGLE_CREDENTIALS=./google-service-account.json

# --- Pagar -------------------------------------------------------------------
# MODE UJI: kalau diisi (628xxx, pisahkan koma), bot HANYA membalas nomor-nomor
# ini dan mengabaikan semua chat lain. Wajib diisi waktu mencoba di nomor yang
# sudah punya pelanggan. Kosongkan baru setelah siap melayani semua orang.
ONLY_NUMBERS=
# Pesan masuk per nomor per 24 jam yang masih dibalas. Lewat = diam.
MAX_INBOUND_PER_NUMBER=40
# Pesan beruntun digabung kalau jaraknya di bawah ini (milidetik).
DEBOUNCE_MS=4000

# --- Jalur baileys -----------------------------------------------------------
# Folder kredensial = akses penuh ke nomor itu. Jangan pernah dibagikan.
WA_AUTH_DIR=./auth
# Isi nomor (628xxx) buat pairing pakai kode 8 digit; kosong = scan QR.
WA_PAIRING_NUMBER=

# --- Jalur cloud -------------------------------------------------------------
WA_PHONE_NUMBER_ID=
# Token akses (System User, permanen).
WA_TOKEN=
# App Secret: dipakai memeriksa tanda tangan tiap webhook. Wajib.
WA_APP_SECRET=
# Karang sendiri; diketik sama persis di dasbor Meta waktu mendaftarkan webhook.
WA_VERIFY_TOKEN=
WA_API_BASE=https://graph.facebook.com/v23.0
PORT=3000
# Template (utility, satu variabel {{1}}) untuk notifikasi ke nomor sales yang
# BERBEDA dari nomor bot. Kosong = teks biasa, yang hanya sampai kalau sales
# pernah mengirim pesan ke nomor bot dalam 24 jam terakhir.
WA_LEAD_TEMPLATE=
WA_LEAD_TEMPLATE_LANG=id

# Bawaan: ./data/<BUSINESS>.db
DB_PATH=

# --- Dashboard pemilik -------------------------------------------------------
# Kosong = dashboard mati. Minimal 8 karakter. Dengan ini terisi, `npm start`
# ikut menyalakan dashboard di http://localhost:3100/admin; `npm run admin`
# menyalakan dashboard saja, tanpa WhatsApp.
ADMIN_PASSWORD=
ADMIN_PORT=3100
# Bawaan hanya bisa dibuka dari komputer ini. Isi 0.0.0.0 untuk membukanya ke
# jaringan — HANYA di belakang HTTPS (reverse proxy), karena kata sandi lewat sini.
ADMIN_HOST=127.0.0.1
# Tempat profil hasil dashboard dan foto: <DATA_DIR>/<BUSINESS>/
DATA_DIR=./data

# --- Dashboard online (opsional) ---------------------------------------------
# Token Vercel Blob. Diisi = bot mengikuti profil + foto yang disimpan dashboard
# online (Vercel), menariknya tepat sebelum membalas, dan dashboard lokal tidak
# dinyalakan. Token yang sama dipakai proyek Vercel-nya. Kosong = semua lokal.
BLOB_READ_WRITE_TOKEN=
BLOB_ACCESS=private

# --- Pengaman nomor (jalur baileys) ------------------------------------------
# Batas kiriman bot. Lewat batas per menit = mengantre; lewat batas per jam /
# per 24 jam = kiriman ditolak sampai jendelanya lewat. Bot juga berhenti
# mengirim sendiri kalau WhatsApp memberi tanda pembatasan (lihat log [pengaman]).
WA_MAX_PER_MINUTE=5
WA_MAX_PER_HOUR=100
WA_MAX_PER_DAY=800

# --- Log & pengawas ----------------------------------------------------------
# `npm start` menjalankan bot lewat pengawas: keluaran disimpan ke LOG_DIR
# (satu berkas per hari) dan bot dinyalakan lagi kalau mati.
LOG_DIR=./logs
LOG_KEEP_DAYS=14

# --- Peringatan untuk pemilik ------------------------------------------------
# Peringatan (pelanggan butuh staf, WhatsApp terputus, kiriman dijeda, LLM
# bermasalah, bot mati) selalu tampil di dashboard dan dikirim ke SALES_NUMBER
# lewat WhatsApp selama WhatsApp-nya jalan. Telegram opsional: satu-satunya
# jalur yang tetap sampai saat WhatsApp-nya sendiri yang bermasalah.
# Buat bot di @BotFather, lalu isi token dan id chat Anda.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
