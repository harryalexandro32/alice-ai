# Salin ke .env lalu isi. .env tidak ikut git.
#
# .env ini dipakai bersama oleh dashboard dan SEMUA bot di mesin ini. Yang khas
# satu bisnis (proyek) TIDAK ada di sini, tapi di database dan diatur dari
# dashboard: jalur WhatsApp (baileys/cloud), nomor bot, nomor sales, mode uji,
# follow-up, profil, berkas. Satu proyek = satu bisnis = satu nomor WhatsApp.

# --- Database ------------------------------------------------------------------
# Satu database untuk semua proyek. Tiga bentuk:
#   postgres://alice:SANDI@127.0.0.1:5432/alice   PostgreSQL sungguhan (server)
#   pglite://./data/pg                            PostgreSQL di dalam proses,
#                                                 disimpan di folder itu (PC lokal)
#   memory://                                     di memori, hilang saat berhenti (uji coba)
# Tabelnya dibuat/diperbarui otomatis saat bot atau dashboard start.
DATABASE_URL=pglite://./data/pg

# --- Proyek (hanya untuk bot) --------------------------------------------------
# Bot melayani satu proyek per proses. Biasanya diisi di perintahnya, bukan di
# sini: `PROJECT=gfan npm run bot` (di server: alice-bot@gfan.service).
# PROJECT=gfan

# --- LLM (OpenAI-compatible; bawaan DeepSeek) --------------------------------
# Kosong = bot tetap jalan: salam, minta data, follow-up, tapi pertanyaan
# dijawab dengan "kami teruskan ke tim".
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# Batas panggilan per hari. Habis = balasan cadangan, bukan mati.
LLM_DAILY_LIMIT=1500
# Tarif untuk perkiraan biaya di dashboard, USD per 1 juta token, dan kurs.
# Bawaan = tarif jam sibuk DeepSeek (di luar jam sibuk separuhnya).
LLM_PRICE_IN=0.3
LLM_PRICE_CACHED=0.006
LLM_PRICE_OUT=1.2
USD_IDR=16500

# --- Waktu -------------------------------------------------------------------
BOT_TZ=Asia/Jakarta

# --- Follow-up ---------------------------------------------------------------
# Angka-angka di bagian ini dan di bawahnya (follow-up, jeda manusia, batas)
# adalah BAWAAN untuk semua proyek; tiap proyek bisa menimpanya di dashboard
# (Pengaturan).
# Jam diam pelanggan sebelum diingatkan. 23 = masih di dalam jendela gratis
# 24 jam Cloud API. Follow-up hanya dikirim di antara dua jam di bawah.
FOLLOWUP_AFTER_HOURS=23
# Batas atas acakannya: tiap follow-up menunggu di antara dua angka ini.
# Di jalur cloud, jadwalnya tetap tidak melewati jendela 24 jam.
FOLLOWUP_AFTER_HOURS_MAX=25
FOLLOWUP_START_HOUR=8
FOLLOWUP_END_HOUR=20
# Batas keras jam sejak pesan terakhir pelanggan. Kosong = otomatis: 24 di
# jalur cloud (yang jatuh malam dimajukan ke sore), tanpa batas di baileys.
FOLLOWUP_MAX_HOURS=
# Total follow-up seumur satu nomor.
FOLLOWUP_MAX_TOTAL=2

# --- Manusia mengambil alih ---------------------------------------------------
# Kalau pemilik membalas sendiri dari aplikasi, bot diam selama ini untuk kontak itu.
HUMAN_PAUSE_HOURS=12

# --- Tujuan lead -------------------------------------------------------------
# Nomor sales penerima ringkasan lead diatur per proyek di dashboard
# (Pengaturan > Proyek). Google Sheet: ID dari URL, nama tab, dan file kunci akun layanan.
# Sheet-nya harus dibagikan (Editor) ke email akun layanan tersebut.
SHEET_ID=
SHEET_TAB=Leads
GOOGLE_CREDENTIALS=./google-service-account.json

# --- Pagar -------------------------------------------------------------------
# Mode uji (bot hanya membalas nomor tertentu) diatur per proyek di dashboard.
# Pesan masuk per nomor per 24 jam yang masih dibalas. Lewat = diam.
MAX_INBOUND_PER_NUMBER=40
# Pesan beruntun digabung kalau jaraknya di bawah ini (milidetik).
DEBOUNCE_MS=4000

# --- Jalur baileys -----------------------------------------------------------
# Sesi WhatsApp tiap proyek disimpan di auth/<proyek>/ (= akses penuh ke nomor
# itu; jangan pernah dibagikan). Menautkan nomor: dashboard > Pengaturan >
# WhatsApp (QR atau kode pairing 8 huruf).

# --- Jalur cloud -------------------------------------------------------------
WA_PHONE_NUMBER_ID=
# Token akses (System User, permanen).
WA_TOKEN=
# App Secret: dipakai memeriksa tanda tangan tiap webhook. Wajib.
WA_APP_SECRET=
# Karang sendiri; diketik sama persis di dasbor Meta waktu mendaftarkan webhook.
WA_VERIFY_TOKEN=
WA_API_BASE=https://graph.facebook.com/v23.0
PORT=3000
# Template (utility, satu variabel {{1}}) untuk notifikasi ke nomor sales yang
# BERBEDA dari nomor bot. Kosong = teks biasa, yang hanya sampai kalau sales
# pernah mengirim pesan ke nomor bot dalam 24 jam terakhir.
WA_LEAD_TEMPLATE=
WA_LEAD_TEMPLATE_LANG=id

# --- Dashboard pemilik -------------------------------------------------------
# Satu dashboard untuk semua proyek: `npm run admin` -> http://localhost:3100/admin
# (proses sendiri, terpisah dari bot). Wajib diisi, minimal 8 karakter.
ADMIN_PASSWORD=
ADMIN_PORT=3100
# Bawaan hanya bisa dibuka dari komputer ini. Isi 0.0.0.0 untuk membukanya ke
# jaringan — HANYA di belakang HTTPS (reverse proxy), karena kata sandi lewat sini.
ADMIN_HOST=127.0.0.1
# Tempat foto dan PDF unggahan: <DATA_DIR>/<proyek>/media/
DATA_DIR=./data

# Alamat dashboard online yang meneruskan permintaan ke server ini (Vercel,
# lihat vercel.json). Pisahkan koma. Kosong = hanya dari host-nya sendiri.
ADMIN_ORIGINS=https://alice.lukicenturi.com

# --- Pengaman nomor (jalur baileys) ------------------------------------------
# Batas kiriman bot. Lewat batas per menit = mengantre; lewat batas per jam /
# per 24 jam = kiriman ditolak sampai jendelanya lewat. Bot juga berhenti
# mengirim sendiri kalau WhatsApp memberi tanda pembatasan (lihat log [pengaman]).
WA_MAX_PER_MINUTE=5
WA_MAX_PER_HOUR=100
WA_MAX_PER_DAY=800

# --- Log & pengawas ----------------------------------------------------------
# `npm start` menjalankan bot lewat pengawas: keluaran disimpan ke LOG_DIR
# (satu berkas per hari) dan bot dinyalakan lagi kalau mati.
LOG_DIR=./logs
LOG_KEEP_DAYS=14

# --- Notifikasi untuk pemilik dan staf --------------------------------------
# SIAPA yang dikabari (nomor WhatsApp, email, id chat Telegram, peran pemilik /
# staf, dan jenis kabar mana ke siapa) diatur di dashboard: Pengaturan >
# Notifikasi. Di sini hanya RAHASIA jalurnya. Panduan: docs/notifikasi.md.
#
# Telegram: buat bot di @BotFather, salin tokennya ke sini.
TELEGRAM_BOT_TOKEN=
# Email lewat SMTP. Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER =
# alamat Gmail, SMTP_PASS = "sandi aplikasi" 16 huruf (bukan sandi Gmail biasa).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Nama/alamat pengirim; kosong = SMTP_USER.
SMTP_FROM=
# Penerima bawaan, dipakai juga selama daftar di dashboard masih kosong:
TELEGRAM_CHAT_ID=
ALERT_EMAIL_TO=

# --- Foto dari pelanggan -----------------------------------------------------
# true = foto kiriman pelanggan ikut dikirim ke LLM untuk diamati, supaya bot
# bisa menyarankan produk dari fotonya. Modelnya harus bisa membaca gambar.
LLM_VISION=true

# --- Follow-up ditulis menurut percakapan -------------------------------------
# true = tiap follow-up ditulis LLM dari isi percakapan pelanggan itu. Kalau LLM
# mati atau jawabannya ditolak pagar, kalimat tetap yang dipakai.
FOLLOWUP_SMART=true

# --- Pesan suara -> teks (opsional) -------------------------------------------
# DeepSeek tidak menerima audio, jadi ini penyedia terpisah dengan kunci sendiri.
# Layanan apa pun yang punya POST {STT_BASE_URL}/audio/transcriptions berformat
# OpenAI bisa dipakai, mis.:
#   Groq   : STT_BASE_URL=https://api.groq.com/openai/v1  STT_MODEL=whisper-large-v3
#   OpenAI : STT_BASE_URL=https://api.openai.com/v1       STT_MODEL=whisper-1
# Kosong = pesan suara diteruskan ke staf seperti biasa.
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=whisper-large-v3
STT_LANGUAGE=id
