# /etc/caddy/Caddyfile — HTTPS otomatis (Let's Encrypt) di depan dashboard bot.
# Dashboard di Vercel (alice.lukicenturi.com) meneruskan permintaannya ke sini.

alice-api.lukicenturi.com {
	encode gzip

	# Jalur WhatsApp Cloud API (TRANSPORT=cloud): webhook Meta masuk lewat sini.
	handle /webhook* {
		reverse_proxy 127.0.0.1:3000
	}
	handle /health {
		reverse_proxy 127.0.0.1:3000
	}

	# Dashboard pemilik (ADMIN_PORT).
	handle {
		reverse_proxy 127.0.0.1:3100
	}
}
