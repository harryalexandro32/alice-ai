{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "{src/admin/page.html,src/admin/app.js,node_modules/unpdf/dist/**}"
    }
  },
  "rewrites": [
    {
      "source": "/((?!robots.txt).*)",
      "destination": "/api/index"
    }
  ],
  "regions": [
    "sin1"
  ]
}
